FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL=https://adyago.stampingadyawinsa.com/api/v1
ARG VITE_IDEMPIERE_CLIENT_ID=1000000
ARG VITE_IDEMPIERE_ORG_ID=0
ARG VITE_IDEMPIERE_TENANT_NAME="PT. Adyawinsa Plastics Industry"
ARG VITE_IDEMPIERE_DOC_TYPE_PR_ID=1000018
ARG VITE_IDEMPIERE_PR_DEFAULT_PRICELIST_ID=1000208
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_IDEMPIERE_CLIENT_ID=$VITE_IDEMPIERE_CLIENT_ID
ENV VITE_IDEMPIERE_ORG_ID=$VITE_IDEMPIERE_ORG_ID
ENV VITE_IDEMPIERE_TENANT_NAME=$VITE_IDEMPIERE_TENANT_NAME
ENV VITE_IDEMPIERE_DOC_TYPE_PR_ID=$VITE_IDEMPIERE_DOC_TYPE_PR_ID
ENV VITE_IDEMPIERE_PR_DEFAULT_PRICELIST_ID=$VITE_IDEMPIERE_PR_DEFAULT_PRICELIST_ID
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
