PORT=8080
GIN_MODE=debug

# iDempiere REST API
IDEMPIERE_API_BASE_URL=https://api-erp.adyawinsa.com/api/v1

# iDempiere PostgreSQL Database
IDEMPIERE_DB_HOST=192.168.3.50
IDEMPIERE_DB_PORT=5432
IDEMPIERE_DB_USER=your_db_user
IDEMPIERE_DB_PASSWORD=your_db_password
IDEMPIERE_DB_NAME=idempiere
IDEMPIERE_DB_SSLMODE=disable

# iDempiere ERP Constants & Defaults (Optional Overrides)
IDEMPIERE_CLIENT_ID=1000000
IDEMPIERE_ORG_ID=0
IDEMPIERE_TENANT_NAME="PT. Adyawinsa Plastics Industry"
IDEMPIERE_DOC_TYPE_PURCHASE_REQUISITION_ID=1000018
IDEMPIERE_PR_DEFAULT_PRICELIST_ID=1000208
IDEMPIERE_PR_DEFAULT_PRIORITY=5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
